+/* ================= 0023: native DFS offload engine =================
+ * 6.18 removed the .start_radar_detection/.end_cac ieee80211_ops pair;
+ * DFS on such kernels is the NL80211_EXT_FEATURE_DFS_OFFLOAD contract:
+ * the driver autonomously runs the CAC (firmware RDD monitoring + CAC
+ * timer) and reports NL80211_RADAR_CAC_STARTED / CAC_FINISHED /
+ * CAC_ABORTED so hostapd can steer the AP, and radar hits mid-operation
+ * go through ieee80211_radar_detected() so hostapd vacates via CSA.
+ *
+ * Triggers (all idempotent, dev->mt76.mutex held):
+ *   - .config(IEEE80211_CONF_CHANGE_CHANNEL)  (hostapd set_freq)
+ *   - bss_info_changed(BSS_CHANGED_BEACON_ENABLED)
+ *   - post-chip-reset re-evaluation (mt7921_mac_reset_work tail)
+ *   - vif removal clears CAC/vif state (mt7921_remove_interface)
+ */
+static int mt7921_mcu_rdd_set(struct mt792x_dev *dev, bool enable)
+{
+        struct {
+                __le16 tag;
+                __le16 len;
+                u8 rdd_idx;
+                u8 enable;
+                u8 rsv[2];
+        } __packed req = {
+                .tag = cpu_to_le16(UNI_RDD_ON_OFF_CTRL),
+                .len = cpu_to_le16(sizeof(req) - 4),
+                .rdd_idx = 0,
+                .enable = enable,
+        };
+
+        return mt76_mcu_send_msg(&dev->mt76, MCU_UNI_CMD(RDD_CTRL),
+                                 &req, sizeof(req), true);
+}
+
+static void
+mt7921_dfs_cac_emit(struct mt792x_dev *dev, struct ieee80211_vif *vif,
+                    const struct cfg80211_chan_def *chandef,
+                    enum nl80211_radar_event evt)
+{
+        struct wireless_dev *wdev = ieee80211_vif_to_wdev(vif);
+
+        if (!wdev || !wdev->netdev || !chandef->chan)
+                return;
+
+        /* GFP_ATOMIC: also called from the CAC timer (softirq). */
+        cfg80211_cac_event(wdev->netdev, chandef, evt, GFP_ATOMIC, 0);
+}
+
+/* Stop the offload CAC / RDD monitoring (channel change, AP down, vif
+ * removal, chip reset). Process context, may send an MCU command. */
+static void mt7921_dfs_cac_stop(struct mt792x_dev *dev, bool emit_aborted)
+{
+        struct mt7921_dfs_state *dfs = &dev->phy.dfs_state;
+        struct ieee80211_vif *vif = dfs->cac_vif;
+        struct cfg80211_chan_def chandef = dfs->cac_chandef;
+        bool was_active = dfs->cac_active;
+
+        timer_delete_sync(&dfs->cac_timer);
+
+        if (emit_aborted && was_active && vif)
+                mt7921_dfs_cac_emit(dev, vif, &chandef,
+                                    NL80211_RADAR_CAC_ABORTED);
+
+        dfs->cac_active = false;
+        dfs->cac_center_freq = 0;
+        dfs->cac_vif = NULL;
+        memset(&dfs->cac_chandef, 0, sizeof(dfs->cac_chandef));
+
+        if (dfs->rdd_enabled) {
+                dfs->rdd_enabled = false;
+                mt7921_mcu_rdd_set(dev, false);
+        }
+}
+
+static void mt7921_dfs_ap_iter(void *data, u8 *mac,
+                               struct ieee80211_vif *vif)
+{
+        if (vif->type == NL80211_IFTYPE_AP ||
+            vif->type == NL80211_IFTYPE_P2P_GO)
+                *(struct ieee80211_vif **)data = vif;
+}
+
+/* Re-evaluate the DFS offload state for the current operating channel.
+ * Caller holds dev->mt76.mutex. */
+static void __mt7921_dfs_offload_update(struct mt792x_dev *dev)
+{
+        struct mt7921_dfs_state *dfs = &dev->phy.dfs_state;
+        struct cfg80211_chan_def chandef = dev->mt76.phy.chandef;
+        struct ieee80211_channel *chan = chandef.chan;
+        struct ieee80211_vif *vif;
+        unsigned int cac_time_ms;
+        int ret;
+
+        if (!chan) {
+                mt7921_dfs_cac_stop(dev, true);
+                return;
+        }
+
+        if (!(chan->flags & IEEE80211_CHAN_RADAR)) {
+                /* left DFS: end monitoring, abort in-flight CAC */
+                if (dfs->cac_active || dfs->rdd_enabled)
+                        mt7921_dfs_cac_stop(dev, true);
+                return;
+        }
+
+        /* in-flight CAC for a different channel: restart it */
+        if (dfs->cac_active &&
+            dfs->cac_center_freq != chan->center_freq)
+                mt7921_dfs_cac_stop(dev, true);
+
+        if (dfs->cac_active)
+                return; /* CAC running on this channel */
+
+        if (chan->dfs_state == NL80211_DFS_AVAILABLE)
+                return; /* CAC already satisfied */
+
+        if (chan->dfs_state != NL80211_DFS_USABLE) {
+                dev_dbg(dev->mt76.dev,
+                        "sl0023: DFS ch %d unavailable (NOP)\n",
+                        chan->hw_value);
+                return;
+        }
+
+        if (!dfs->rdd_enabled) {
+                ret = mt7921_mcu_rdd_set(dev, true);
+                if (ret) {
+                        dev_err(dev->mt76.dev,
+                                "sl0023: firmware RDD enable failed (%d) - DFS offload CAC cannot run\n",
+                                ret);
+                        return;
+                }
+                dfs->rdd_enabled = true;
+        }
+
+        vif = dfs->cac_vif;
+        if (!vif) {
+                ieee80211_iterate_active_interfaces(
+                                dev->mt76.phy.hw,
+                                IEEE80211_IFACE_ITER_RESUME_ALL,
+                                mt7921_dfs_ap_iter, &vif);
+                dfs->cac_vif = vif;
+        }
+        if (!vif) {
+                /* no AP/GO vif yet: RDD stays armed, CAC starts on a
+                 * later BEACON_ENABLED / channel-set pass with a vif */
+                return;
+        }
+
+        cac_time_ms = cfg80211_chandef_dfs_cac_time(
+                        dev->mt76.phy.hw->wiphy, &chandef);
+        if (!cac_time_ms)
+                cac_time_ms = IEEE80211_DFS_MIN_CAC_TIME_MS;
+
+        dfs->radar_detected = false;
+        dfs->cac_band_idx = 0;
+        dfs->cac_time_ms = cac_time_ms;
+        dfs->cac_chandef = chandef;
+        dfs->cac_active = true;
+        dfs->cac_center_freq = chan->center_freq;
+        dfs->cac_vif = vif;
+
+        mod_timer(&dfs->cac_timer,
+                  jiffies + msecs_to_jiffies(cac_time_ms));
+
+        mt7921_dfs_cac_emit(dev, vif, &chandef,
+                            NL80211_RADAR_CAC_STARTED);
+        dev_info(dev->mt76.dev,
+                 "sl0023: DFS offload CAC started (ch %d, %u ms)\n",
+                 chan->hw_value, cac_time_ms);
+}
+
+void mt7921_dfs_offload_update(struct mt792x_dev *dev)
+{
+        mt792x_mutex_acquire(dev);
+        __mt7921_dfs_offload_update(dev);
+        mt792x_mutex_release(dev);
+}
