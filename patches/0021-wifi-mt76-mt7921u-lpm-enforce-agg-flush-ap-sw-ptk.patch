+/* 0021: USB LPM state enforcement. usb_reset_and_verify_device() ends
+ * with usb_unlocked_enable_lpm() and hub_port_init() rebases
+ * lpm_disable_count=1 and rebuilds udev->quirks from the static list,
+ * so every recovery reset re-arms U1 on the dongle links (observed with
+ * 0020 live: u1=enabled on 2-1.1/2-1.4.3 in every soak snapshot). This
+ * runs from mac_work every 250 ms; the healthy-path cost is a few
+ * struct reads. */
+static void mt792x_usb_lpm_enforce(struct mt76_dev *dev)
+{
+        struct usb_interface *intf;
+        struct usb_device *udev;
+
+        if (!mt76_is_usb(dev))
+                return;
+
+        intf = to_usb_interface(dev->dev);
+        if (!intf)
+                return;
+        udev = interface_to_usbdev(intf);
+        if (!udev || udev->speed < USB_SPEED_SUPER)
+                return;
+
+        /* dead: no link timeouts, no LPM capability left */
+        if (!udev->lpm_capable &&
+            !udev->u1_params.timeout && !udev->u2_params.timeout)
+                return;
+
+        dev_info(dev->dev,
+                 "sl0021: re-armed LPM detected, re-killing (u1=%d u2=%d to=%d/%d cap=%d)\n",
+                 udev->usb3_lpm_u1_enabled, udev->usb3_lpm_u2_enabled,
+                 udev->u1_params.timeout, udev->u2_params.timeout,
+                 udev->lpm_capable);
+        udev->quirks |= USB_QUIRK_NO_LPM;
+        if (udev->u1_params.timeout || udev->u2_params.timeout)
+                usb_disable_lpm(udev);
+        udev->lpm_capable = 0;
+}
