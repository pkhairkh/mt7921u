 EXPORT_SYMBOL_GPL(mt76_rx_aggr_stop);
+
+/* 0021: chip-reset path - flush every RX-aggr reorder session.
+ * Reorder buffers park skbs whose frags own page_pool pages; if a
+ * chip reset (fw re-download / full re-init) leaves the old sessions
+ * stranded, those pages stay inflight forever (observed: pool id 24
+ * stuck at 147 inflight >25 min after the 2026-09-05 16:38 wedge).
+ * Called after the rx worker is stopped, so there is no concurrent
+ * reorder activity. */
+void mt76_rx_aggr_flush(struct mt76_dev *dev)
+{
+        struct mt76_wcid *wcid;
+        struct mt76_rx_tid *tid;
+        int i, tidno;
+
+        rcu_read_lock();
+        for (i = 0; i < MT76_N_WCIDS; i++) {
+                wcid = rcu_dereference(dev->wcid[i]);
+                if (!wcid || !wcid->sta)
+                        continue;
+
+                for (tidno = 0; tidno < IEEE80211_NUM_TIDS; tidno++) {
+                        struct mt76_rx_tid *old;
+
+                        tid = rcu_dereference(wcid->aggr[tidno]);
+                        if (!tid)
+                                continue;
+                        old = rcu_replace_pointer(wcid->aggr[tidno], NULL, 1);
+                        if (old == tid) {
+                                mt76_rx_aggr_shutdown(dev, tid);
+                                kfree_rcu(tid, rcu_head);
+                        }
+                }
+        }
+        rcu_read_unlock();
+}
+EXPORT_SYMBOL_GPL(mt76_rx_aggr_flush);
