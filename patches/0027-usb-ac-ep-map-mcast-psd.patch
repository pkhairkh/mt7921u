 #include "mt76.h"
 #include "mt792x_compat.h"
 
+/* sl0027: route multicast/broadcast TX frames to the mc/PSD queue
+ * (out_ep[HCCA], the pipe the fw reserves for mcast/DTIM traffic).
+ * Evidence (0026a): a single broadcast data frame sent down the AC data
+ * pipes permanently wedges the MT7961 fw's AP-BSS BE queue - URBs stop
+ * completing, unicast BE dies with it, only a BSS reset recovers. The
+ * mcast frames must never ride a per-AC data pipe in AP mode.
+ */
+static bool sl_mc_psd = true;
+module_param_named(sl_mc_psd, sl_mc_psd, bool, 0644);
+MODULE_PARM_DESC(sl_mc_psd, "Route mcast/bc frames to the mc/PSD queue (default: on)");
+static atomic_t sl27_mc_reroute;
+
+static bool mt76_sl_is_mcast(struct sk_buff *skb)
+{
+        struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+        const u8 *addr;
+
+        /* 802.3 hw-encap frames: h_dest at offset 0;
+         * native 802.11 frames: addr1 follows fc + duration */
+        if (info->flags & IEEE80211_TX_CTL_HW_80211_ENCAP)
+                addr = skb->data;
+        else
+                addr = skb->data + 4;
+
+        return is_multicast_ether_addr(addr);
+}
