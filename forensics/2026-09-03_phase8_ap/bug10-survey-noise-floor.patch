                         status->signal = max(status->signal,
                                              status->chain_signal[i]);
                 }
+
+                mt7921_rx_update_chan_nf(dev, chfreq, status->band,
+                                         status->signal);
         }
 
         amsdu_info = FIELD_GET(MT_RXD4_NORMAL_PAYLOAD_FORMAT, rxd4);
