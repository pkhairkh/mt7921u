@@ -1351,6 +1409,8 @@ int mt7921_set_tx_sar_pwr(struct ieee80211_hw *hw,
         }
         mt792x_init_acpi_sar_power(mt792x_hw_phy(hw), !sar);
 
+        mt7921_update_txpower_cur(hw);
+
         return mt76_connac_mcu_set_rate_txpower(mphy);
 }
 
